# Backend API origin only. The client appends /api/v1 to application API paths.
# Local backend: http://localhost:9001
# Physical Android device: use the development computer's LAN IP instead of localhost.
NEXT_PUBLIC_API_URL=http://localhost:9001

# Set true only for local frontend development without the backend.
# Mock mode is automatically disabled in production builds.
NEXT_PUBLIC_KAMBA_MOCK_MODE=false
