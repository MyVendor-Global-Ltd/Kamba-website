{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": true,
      "**": false
    }
  },
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "kambastore.vercel.app"
        }
      ],
      "destination": "https://kamba.ng/:path*",
      "permanent": true
    }
  ]
}
